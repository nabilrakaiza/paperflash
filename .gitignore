# working notes / AI instructions
CLAUDE.md

# python
__pycache__/
*.py[cod]
.venv/
venv/

# colab / jupyter
.ipynb_checkpoints/

# datasets — re-downloaded, never committed. data/* rather than data/:
# git cannot re-include a file once its whole directory is excluded.
data/*
# except the tokenizer: every checkpoint is indexed by its token ids, so it
# is versioned with the code (and retraining it takes minutes)
!data/tokenizer.json

# training artifacts — regenerate by rerunning, too big for git
checkpoints/
*.pt
*.pth
*.ckpt
runs/
wandb/

# note: phase6_writeup/plots/ is deliberately NOT ignored — plots are
# part of the write-up and should be committed.

# macos
.DS_Store
